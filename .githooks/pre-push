#!/usr/bin/env bash
# vteam managed pre-push — the fence that makes branch-only-merges real.
#
# Rules live in prose everywhere; this hook is where they can actually go red.
# Install (once per clone): git config core.hooksPath .githooks
# (vteam doctor verifies this; a clone with silent hooks turns law into prose.)
#
# Deliberate bypasses must act, not whisper:
#   ALLOW_PUSH_MAIN=1      — push to the protected branch directly
#   ALLOW_PUSH_NOREVIEW=1  — push code without the review dossier
# Every bypass writes a durable line to the hatch log. The secret scan runs
# before every hatch and has none.
set -uo pipefail
PROTECTED=$(python3 .vteam/scripts/lib/ctx.py git.protected_branch 2>/dev/null || echo main)
PM_DIR=$(python3 .vteam/scripts/lib/ctx.py paths.pm 2>/dev/null || echo docs/pm)
KEY=$(python3 .vteam/scripts/lib/ctx.py project.key 2>/dev/null || echo '[A-Z]+')
# branch grammar comes from config (git.branch_pattern, {key} substituted) —
# the pattern the docs promise is the pattern the fence enforces
BRANCH_PATTERN=$(python3 .vteam/scripts/lib/ctx.py git.branch_pattern 2>/dev/null \
  || echo '^(feat|fix)/{key}-[0-9]+-')
BRANCH_PATTERN="${BRANCH_PATTERN//\{key\}/$KEY}"
ZERO="0000000000000000000000000000000000000000"

# scan_base <local_sha> — prints the diff base for outgoing-content checks.
# FAIL CLOSED: when origin/<protected> is unavailable (first push, offline,
# renamed default branch), fall back to the EMPTY TREE so the full content of
# the push is scanned — never silently skip the secret scan.
scan_base() {
  git fetch -q origin "$PROTECTED" 2>/dev/null || true
  if git rev-parse --verify -q "origin/$PROTECTED^{commit}" >/dev/null 2>&1; then
    printf 'origin/%s...%s' "$PROTECTED" "$1"
  else
    echo "⚠️  origin/$PROTECTED unavailable — scanning the FULL outgoing content (fail closed, never open)" >&2
    printf '%s %s' "$(git hash-object -t tree /dev/null)" "$1"
  fi
}

log_hatch() { # <hatch name> <branch>
  local f="$PM_DIR/hatch-log.md"
  [[ -f "$f" ]] || printf '# Escape-hatch log — one line per use, committed with the next change\n\n' > "$f"
  printf -- '- %s · %s · branch `%s` · reason: %s\n' \
    "$(date '+%Y-%m-%d %H:%M')" "$1" "$2" "${HATCH_REASON:-<unrecorded — add by hand>}" >> "$f"
  echo "   → trace written to $f (commit it with your next change)"
}

while read -r _local_ref local_sha remote_ref _remote_sha; do
  branch="${remote_ref#refs/heads/}"
  [[ "$local_sha" == "$ZERO" ]] && continue   # deleting a remote branch — nothing to check

  # 0) SECRET SCAN — before every exit ramp: there is no legitimate secret push,
  #    even with the hatches on. High-precision token patterns only.
  read -r -a DIFF_BASE <<< "$(scan_base "$local_sha")"
  LEAK=$(git diff "${DIFF_BASE[@]}" | grep -E '^\+' \
    | grep -oE 'figd_[A-Za-z0-9_-]{20,}|ATATT[A-Za-z0-9_=-]{20,}|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|AKIA[0-9A-Z]{16}|sk-[A-Za-z0-9_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----' \
    | head -3 || true)
  if [[ -n "$LEAK" ]]; then
    echo "❌ SECRET in the outgoing diff (no escape hatch exists for this):"
    echo "$LEAK" | sed 's/^/     /;s/\(.\{12\}\).*/\1…/'
    echo "   Strip it from the commits (rebase/amend), push again. Exposed token → REVOKE now."
    exit 1
  fi

  # 1) No direct pushes to the protected branch
  if [[ "$branch" == "$PROTECTED" ]]; then
    if [[ "${ALLOW_PUSH_MAIN:-}" == "1" ]]; then
      echo "⚠️  ALLOW_PUSH_MAIN=1 — passing on declared intent"
      log_hatch "ALLOW_PUSH_MAIN" "$branch"
      continue
    fi
    echo "❌ No direct pushes to '$PROTECTED'."
    echo "   Everything reaches $PROTECTED through a PR with green CI — code, docs, config alike."
    echo "     git checkout -b <feat|fix|chore|docs>/<slug>"
    echo "     git push -u origin <branch> && open a PR"
    echo "   Genuinely need a direct push: ALLOW_PUSH_MAIN=1 git push origin $PROTECTED"
    exit 1
  fi

  # 2) EVERY branch carrying product code — gated by diff CONTENT, not branch name.
  #    (The old name-based guard let `chore/…` branches carry code around the whole
  #    review, without any hatch.)
  CODE_PATHS=$(python3 - <<'PY' 2>/dev/null || true
import sys; sys.path.insert(0, ".vteam/scripts/lib")
from ctx import Ctx
raw = Ctx().cfg("git.code_paths", [])
raw = raw if isinstance(raw, list) else [raw]
paths = [str(p) for p in raw if str(p).strip()]
if paths:
    print("^(" + "|".join(paths) + ")")
PY
)
  if [[ -z "$CODE_PATHS" ]]; then
    # FAIL CLOSED: empty git.code_paths (init could not derive it) or an
    # unreadable config means we cannot tell product code from the rest —
    # so EVERY path is product code until git.code_paths says otherwise.
    echo "⚠️  git.code_paths is empty or unreadable — FAILING CLOSED: treating EVERY path as product code."
    echo "   Set git.code_paths in vteam.config.yaml to scope the fence (an unscoped fence stays SHUT, never silently open)."
    CODE_PATHS='^'
  fi
  if git diff --name-only "${DIFF_BASE[@]}" | grep -qE "$CODE_PATHS"; then
    if [[ "${ALLOW_PUSH_NOREVIEW:-}" == "1" ]]; then
      echo "⚠️  ALLOW_PUSH_NOREVIEW=1 — passing on declared intent"
      log_hatch "ALLOW_PUSH_NOREVIEW" "$branch"
      continue
    fi
    if [[ ! "$branch" =~ $BRANCH_PATTERN ]]; then
      echo "❌ Diff touches product code but branch '$branch' does not match the"
      echo "   configured branch grammar: $BRANCH_PATTERN (git.branch_pattern)"
      echo "   Product code travels on ticket-keyed branches (ticket↔code tracing, raci.md)."
      echo "   Rename: git branch -m feat/${KEY}-nn-<slug>. Hatch: ALLOW_PUSH_NOREVIEW=1 (logged)."
      exit 1
    fi
    if ! python3 .vteam/scripts/review_check.py "$branch" \
           --base "origin/$PROTECTED" --sha "$local_sha"; then
      echo ""
      echo "   Code leaves the machine only with the committed review dossier + full cards."
      echo "   Genuine exception: ALLOW_PUSH_NOREVIEW=1 git push … (logged)."
      exit 1
    fi
  fi
done
exit 0
