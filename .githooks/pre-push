#!/usr/bin/env bash
# vteam repo fence — all work reaches main through a branch + PR, and no push
# carries a secret (the rules this repo ships to others apply to itself).
# Install once per clone:  git config core.hooksPath .githooks
# Deliberate bypass (leaves you accountable): ALLOW_PUSH_MAIN=1 git push origin main
set -uo pipefail
ZERO="0000000000000000000000000000000000000000"
while read -r _lref lsha rref _rsha; do
  [[ "$lsha" == "$ZERO" ]] && continue

  # SECRET SCAN — before every exit ramp; there is no hatch for this one.
  # FAIL CLOSED: no origin/main to diff against → scan the full outgoing content.
  if git rev-parse --verify -q "origin/main^{commit}" >/dev/null 2>&1; then
    DIFF_BASE=("origin/main...$lsha")
  else
    echo "⚠️  origin/main unavailable — scanning the FULL outgoing content (fail closed)" >&2
    DIFF_BASE=("$(git hash-object -t tree /dev/null)" "$lsha")
  fi
  LEAK=$(git diff "${DIFF_BASE[@]}" | grep -E '^\+' \
    | grep -oE 'figd_[A-Za-z0-9_-]{20,}|ATATT[A-Za-z0-9_=-]{20,}|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|AKIA[0-9A-Z]{16}|sk-[A-Za-z0-9_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----' \
    | head -3 || true)
  if [[ -n "$LEAK" ]]; then
    echo "❌ SECRET in the outgoing diff (no escape hatch exists for this):"
    echo "$LEAK" | sed 's/^/     /;s/\(.\{12\}\).*/\1…/'
    echo "   Strip it from the commits (rebase/amend), push again. Exposed token → REVOKE now."
    exit 1
  fi

  if [[ "${rref#refs/heads/}" == "main" && "${ALLOW_PUSH_MAIN:-}" != "1" ]]; then
    echo "❌ No direct pushes to main — branch + PR (the rule this repo ships to others applies to itself)."
    echo "   git checkout -b <feat|fix|chore|docs>/<slug> && git push -u origin <branch>"
    echo "   Deliberate exception: ALLOW_PUSH_MAIN=1 git push origin main"
    exit 1
  fi
done
exit 0
